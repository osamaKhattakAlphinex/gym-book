# ---------------------------------------------------------------------------
# GymBook — integration environment
#
# Copy to `.env.local` and fill in what you have. Nothing here is required to
# run the app: with an empty file the dashboard works, cash entry works, and
# WhatsApp reminders open with the message pre-filled for you to tap send.
# Filling a block in switches that integration to live on the next request —
# no code change, no rebuild.
#
# Check what is active at any time on Settings → Integrations, or
# GET /api/integrations/status.
# ---------------------------------------------------------------------------

# Public URL of this deployment. Used to build the JazzCash return URL and the
# payment links you send on WhatsApp. On Vercel this is detected automatically.
# APP_BASE_URL=https://gymbook.example.com

# Gym name used on receipts sent automatically by the payment callback.
# NEXT_PUBLIC_GYM_NAME=Iron Peak Fitness


# ---------------------------------------------------------------------------
# JazzCash  (https://sandbox.jazzcash.com.pk — credentials come from your
#            JazzCash merchant onboarding e-mail)
#
# Set all three and online payments turn on: payment links, wallet charges and
# card checkout. Leave them empty and the app stays cash-only.
# ---------------------------------------------------------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# sandbox (default) or live. Start on sandbox — no real money moves.
JAZZCASH_ENV=sandbox

# Optional. Defaults to $APP_BASE_URL/api/jazzcash/callback — register this
# exact URL as your Return URL in the JazzCash merchant portal.
# JAZZCASH_RETURN_URL=

# Optional. How long a generated payment link stays payable.
# JAZZCASH_EXPIRY_MINUTES=60
# JAZZCASH_TIMEOUT_MS=20000


# ---------------------------------------------------------------------------
# WhatsApp — pick ONE provider (or neither)
#
# Neither configured  -> reminders open WhatsApp with the message pre-filled
#                        (the zero-cost path; the owner taps send).
# Meta configured     -> messages are delivered by the WhatsApp Cloud API.
# Twilio configured   -> messages are delivered by Twilio.
#
# If both are set, Meta wins unless WHATSAPP_PROVIDER says otherwise.
# ---------------------------------------------------------------------------

# Force a provider: meta | twilio | link. Leave unset to auto-detect.
# WHATSAPP_PROVIDER=

# --- Option A: WhatsApp Cloud API (Meta) -----------------------------------
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0

# Webhook: set the callback URL to $APP_BASE_URL/api/whatsapp/webhook and use
# this same string as the Verify Token in the Meta dashboard.
# WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 header on inbound calls.
# Strongly recommended in production.
# WHATSAPP_APP_SECRET=

# Approved template names. Outside the 24-hour customer service window Meta
# only delivers templates, so set these before relying on automatic reminders.
# Body parameters are positional: {{1}} name, {{2}} gym, {{3}} date, {{4}} amount.
# WHATSAPP_TEMPLATE_REMINDER=
# WHATSAPP_TEMPLATE_RECEIPT=
# WHATSAPP_TEMPLATE_WELCOME=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Option B: Twilio -------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_MESSAGING_SERVICE_SID=

# Log messages instead of sending them. Useful for demos and staging.
# WHATSAPP_DRY_RUN=false


# ---------------------------------------------------------------------------
# Security & storage
# ---------------------------------------------------------------------------

# Set this on any publicly reachable deployment. When present, /api/whatsapp/send,
# /api/jazzcash/checkout, /api/jazzcash/wallet and /api/jazzcash/transactions
# require `Authorization: Bearer <secret>`. The JazzCash callback and the
# WhatsApp webhook are excluded — they authenticate by signature instead.
# GYMBOOK_API_SECRET=

# Where server-side transaction records are written. Ignored on read-only
# filesystems, where an in-memory store is used instead.
# GYMBOOK_DATA_DIR=.data
